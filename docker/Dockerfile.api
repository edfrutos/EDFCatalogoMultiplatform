# ── Etapa 1: compilar el servidor Dart ───────────────────────────────────────
FROM dart:stable AS builder

WORKDIR /app

# Copiar manifiesto e instalar dependencias
COPY api/pubspec.yaml api/pubspec.lock* ./
RUN dart pub get

# Copiar código fuente
COPY api/ .

# Compilar a binario nativo (AOT)
RUN dart compile exe bin/server.dart -o bin/server

# ── Etapa 2: imagen mínima de producción ─────────────────────────────────────
# FROM scratch evita el conflicto con debian:bookworm-slim donde /lib es un
# symlink a /usr/lib — COPY --from=builder /runtime/ / falla sobre symlinks.
FROM scratch

# Runtime de Dart para binarios AOT
COPY --from=builder /runtime/ /

# Certificados CA para conexiones TLS (MongoDB Atlas + AWS S3)
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

WORKDIR /app

# Binario compilado
COPY --from=builder /app/bin/server /app/bin/server

EXPOSE 8089

CMD ["/app/bin/server"]
