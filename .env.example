# Variables de entorno para EDFCatalogoMultiplatform

# Clave secreta de Flask (protege sesiones y cookies)
SECRET_KEY=
FLASK_SECRET_KEY=
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_APP=app.py

############################
# CONFIGURACIÓN DE MONGODB
# Cambiar de conexión local a Atlas
# URI de conexión a MongoDB Atlas (incluyendo el nombre de la base de datos)
#
# Configuración para edf_catalogotablas
#################################
MONGO_URI=
MONGO_DB=

# Email — SMTP (Gmail). Usado por el API para notificaciones de contacto.
# Con las credenciales Gmail rellenas, el formulario de contacto enviará email sin más config.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Emails de notificación (destino de los mensajes de contacto)
NOTIFICATION_EMAIL_1=
NOTIFICATION_EMAIL_2=

# Email — Brevo API (opcional). Si está configurado, tiene prioridad sobre SMTP.
# Crear cuenta en https://app.brevo.com → Settings → API Keys
BREVO_API_KEY=
# CONFIGURACIÓN DE AWS S3
# Credenciales y configuración de Amazon S3

###########################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-south-2
S3_BUCKET_NAME=
USE_S3=true
# Asegurar que Python encuentre los módulos correctamente
PYTHONPATH=.

#############################################################
# Google API key para usar Gemini en el entorno de desarrollo
GEMINI_API_KEY=

# CONFIGURACIÓN DE GOOGLE DRIVE
# Credenciales para backup automático en Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_REDIRECT_URI=
GOOGLE_DRIVE_FOLDER=
UPLOAD_TO_GOOGLE_DRIVE= true
TRAE_PRESERVE_SESSIONS=true
TRAE_DEBUG_MODE=true

#############################################################
# DISTRIBUCIÓN macOS — Developer ID + notarización
# Ver docs/macos/DISTRIBUCION_MACOS.md
# Si APPLE_TEAM_ID y NOTARY_PROFILE están vacías, scripts/build_macos_dmg.sh
# usa firma ad-hoc (uso interno).
#############################################################
# Team ID de la cuenta Apple Developer (developer.apple.com/account → Membership).
# Con esto basta: el script autoresuelve el certificado "Developer ID Application".
APPLE_TEAM_ID=V29BTBRY6G
# Override opcional de la identidad de firma completa. Normalmente dejar VACÍO
# (se deriva de APPLE_TEAM_ID). Listar disponibles: security find-identity -v -p codesigning
MACOS_SIGN_IDENTITY=
# Perfil de credenciales de notarización. Crear una vez con:
#   xcrun notarytool store-credentials "edf-notary" \
#     --apple-id TU_APPLE_ID --team-id V29BTBRY6G --password APP_SPECIFIC_PASSWORD
NOTARY_PROFILE=edf-notary

################################
# URL base de la API (se usa en Flutter Web para llamadas HTTP).
# Desarrollo local:  API_BASE_URL=http://localhost:8089
# Docker/producción: API_BASE_URL=https://tu-dominio.com/api  (Caddy proxea /api → api:8089)
################################
API_PORT=8089
API_BASE_URL=http://localhost:8089
